NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_WHATSAPP_NUMBER=5511990130543
# Domínio canônico do site. É a URL que monta a og:image, o canonical, o
# sitemap.xml e o robots.txt — sem o domínio certo, o preview do link no
# WhatsApp não aparece e o Google indexa URLs erradas. Se ficar em branco,
# o código cai em https://studioshift.com.br (ver lib/site.ts).
# Em desenvolvimento local, use http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
WIKI_INTERVIEW_TOKEN=
JOTFORM_WEBHOOK_SECRET=
WIKI_LLM_API_URL=
WIKI_LLM_API_KEY=
WIKI_LLM_MODEL=
# Temperatura do agente: mais alto = mais natural/variado (padrão 0.5).
WIKI_LLM_TEMPERATURE=
# Ritmo humano do envio no WhatsApp (Evolution). Tempo de "digitando":
# ms por caractere e os limites mínimo/máximo por balão.
WHATSAPP_TYPING_MS_PER_CHAR=
WHATSAPP_TYPING_MIN_MS=
WHATSAPP_TYPING_MAX_MS=
WIKI_TRANSCRIPTION_API_URL=
WIKI_TRANSCRIPTION_MODEL=
WHATSAPP_WEBHOOK_SECRET=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_SEND_URL=
WHATSAPP_ACCESS_TOKEN=
